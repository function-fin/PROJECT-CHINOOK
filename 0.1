        -- DUPLO CLIQUE: DESATIVA TUDO E DESTRÓI O SCRIPT
        StopLoopMatter()
        ScreenGui:Destroy()
        print("Script Matter TP encerrado por Duplo Clique.")
    else
        -- CLIQUE ÚNICO: MOSTRA / ESCONDE A INTERFACE
        MainFrame.Visible = not MainFrame.Visible
    end
    lastClickTime = currentTime
end)

