-- // LIMPEZA FÍSICA // --
local function limparInstanciasFisicas(corpo)
    if not corpo or not corpo:IsA("BasePart") then return end
    for _, filho in pairs(corpo:GetChildren()) do
        if filho:IsA("BodyVelocity") or filho:IsA("BodyAngularVelocity") or filho:IsA("NoCollisionConstraint") or filho:IsA("BodyPosition") then
            filho:Destroy()
        end
    end
    pcall(function()
        corpo.Velocity = Vector3.new(0, 0, 0)
        corpo.RotVelocity = Vector3.new(0, 0, 0)
        corpo.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        corpo.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    end)
end

-- // BURACO NEGRO (BLACK HOLE OTIMIZADO) // --
task.spawn(function()
    while true do
        if BlackHoleActive then
            for _, item in pairs(Workspace:GetDescendants()) do
                if item:IsA("Model") and (item.Name == "ChinookRescue" or item.Name:lower():find("chinook")) then
                    -- Busca apenas o assento principal do helicóptero
                    local assento = item:FindFirstChild("PilotSeat", true) 
                        or item:FindFirstChildOfClass("VehicleSeat") 
                        or item:FindFirstChildOfClass("Seat")
                    
                    if assento and not assento.Anchored then
                        -- Define a propriedade de NetworkOwner no assento
                        if sethp then
                            pcall(function() sethp(assento, "NetworkOwner", LocalPlayer) end)
                        elseif assento.SetNetworkOwner then
                            pcall(function() assento:SetNetworkOwner(LocalPlayer) end)
                        end

                        limparInstanciasFisicas(assento)
                        assento.CFrame = CFrame.new(BLACK_HOLE_POS)
                        limparInstanciasFisicas(assento)
                    end
                end
            end
        end
        -- Intervalo ajustado para 5 segundos a fim de evitar lag
        task.wait(5)
    end
end)

-- // TELETRANSPORTE NO ASSENTO (SEAT-HOPPING BYPASS) // --
local function executarBypassAssento(assentoAlvo)
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local meuHRP = character:FindFirstChild("HumanoidRootPart")
    local meuHum = character:FindFirstChildOfClass("Humanoid")
    if not meuHRP or not meuHum or not assentoAlvo then return end

    local posicaoOriginal = meuHRP.CFrame

    meuHRP.CFrame = assentoAlvo.CFrame
    task.wait(0.4)

    meuHum.Sit = false
    meuHum.Jump = true
    meuHRP.CFrame = assentoAlvo.CFrame + Vector3.new(0, 8, 0)

    task.wait(0.2)

    meuHRP.CFrame = posicaoOriginal
end

-- // EXECUÇÃO DO MATTER TP // --
local function ExecutarMatterTPNoAlvo()
    if not ScriptActive or not TargetPlayer or not TargetPlayer.Character then return end
    local targetHRP = TargetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not targetHRP then return end

    local destinoCFrame = targetHRP.CFrame * CFrame.new(ALTURA_OFFSET)

    for _, item in pairs(Workspace:GetDescendants()) do
        if item:IsA("Model") and (item.Name == "ChinookRescue" or item.Name:lower():find("chinook")) then
            for _, part in pairs(item:GetDescendants()) do
                if part:IsA("BasePart") and not part.Anchored then
                    if sethp then
                        pcall(function() sethp(part, "NetworkOwner", LocalPlayer) end)
                    elseif part.SetNetworkOwner then
                        pcall(function() part:SetNetworkOwner(LocalPlayer) end)
                    end

                    limparInstanciasFisicas(part)
                    part.CFrame = destinoCFrame
                    limparInstanciasFisicas(part)
                end
            end
        end
    end
end

-- // CONTROLE DO LOOP // --
local function StartLoopMatter()
    ScriptActive = true
    task.spawn(function()
        while ScriptActive do
            ExecutarMatterTPNoAlvo()
            task.wait(1.5)
        end
    end)
end

local function StopLoopMatter()
    ScriptActive = false
end

-- // FUNÇÃO ARRASTÁVEL // --
local function MakeDraggable(guiObject)
    local dragging, dragInput, dragStart, startPos

    local function update(input)
        local delta = input.Position - dragStart
        guiObject.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end

    guiObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = guiObject.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    guiObject.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            update(input)
        end
    end)
end

