-- // ATUALIZAÇÃO DA LISTA DE JOGADORES // --
local function UpdatePlayerList()
    for _, child in pairs(PlayerScrollFrame:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    local count = 0
    local allPlayers = Players:GetPlayers()

    for _, p in pairs(allPlayers) do
        if p ~= LocalPlayer then
            count = count + 1

            local ItemFrame = Instance.new("Frame", PlayerScrollFrame)
            ItemFrame.Size = UDim2.new(1, -6, 0, 32)
            ItemFrame.BackgroundColor3 = (TargetPlayer == p) and Color3.fromRGB(35, 35, 35) or Color3.fromRGB(18, 18, 18)

            local ItemCorner = Instance.new("UICorner", ItemFrame)
            ItemCorner.CornerRadius = UDim.new(0, 4)

            local AvatarImg = Instance.new("ImageLabel", ItemFrame)
            AvatarImg.Size = UDim2.new(0, 24, 0, 24)
            AvatarImg.Position = UDim2.new(0, 4, 0.5, -12)
            AvatarImg.BackgroundTransparency = 1

            -- Thumbnail assíncrona
            task.spawn(function()
                pcall(function()
                    local content = Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
                    AvatarImg.Image = content
                end)
            end)

            local AvatarCorner = Instance.new("UICorner", AvatarImg)
            AvatarCorner.CornerRadius = UDim.new(0, 12)

            local DisplayName = Instance.new("TextLabel", ItemFrame)
            DisplayName.Size = UDim2.new(0, 110, 0, 12)
            DisplayName.Position = UDim2.new(0, 32, 0, 4)
            DisplayName.Text = p.DisplayName
            DisplayName.TextColor3 = Color3.fromRGB(255, 255, 255)
            DisplayName.Font = Enum.Font.GothamBold
            DisplayName.TextSize = 8
            DisplayName.TextXAlignment = Enum.TextXAlignment.Left
            DisplayName.BackgroundTransparency = 1

            local Username = Instance.new("TextLabel", ItemFrame)
            Username.Size = UDim2.new(0, 110, 0, 10)
            Username.Position = UDim2.new(0, 32, 0, 16)
            Username.Text = "@" .. p.Name
            Username.TextColor3 = Color3.fromRGB(140, 140, 140)
            Username.Font = Enum.Font.Gotham
            Username.TextSize = 7
            Username.TextXAlignment = Enum.TextXAlignment.Left
            Username.BackgroundTransparency = 1

            if TargetPlayer == p then
                local CheckMark = Instance.new("TextLabel", ItemFrame)
                CheckMark.Size = UDim2.new(0, 16, 0, 16)
                CheckMark.Position = UDim2.new(1, -20, 0.5, -8)
                CheckMark.Text = "✓"
                CheckMark.TextColor3 = Color3.fromRGB(255, 255, 255)
                CheckMark.Font = Enum.Font.GothamBold
                CheckMark.TextSize = 10
                CheckMark.BackgroundTransparency = 1
            end

            local ClickBtn = Instance.new("TextButton", ItemFrame)
            ClickBtn.Size = UDim2.new(1, 0, 1, 0)
            ClickBtn.BackgroundTransparency = 1
            ClickBtn.Text = ""

            ClickBtn.MouseButton1Click:Connect(function()
                TargetPlayer = p
                UpdatePlayerList()
            end)
        end
    end

    ListTitle.Text = "LISTA DE JOGADORES (" .. tostring(count) .. ")"
    PlayerScrollFrame.CanvasSize = UDim2.new(0, 0, 0, count * 35)
end

local function UpdateChinookList()
    for _, child in pairs(ChinookScrollFrame:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    local count = 0

    -- Escaneamento
    for _, item in pairs(Workspace:GetDescendants()) do
        if item:IsA("Model") and (item.Name == "ChinookRescue" or item.Name:lower():find("chinook")) then
            count = count + 1

            local ItemFrame = Instance.new("Frame", ChinookScrollFrame)
            ItemFrame.Size = UDim2.new(1, -6, 0, 32)
            ItemFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 18)

            local ItemCorner = Instance.new("UICorner", ItemFrame)
            ItemCorner.CornerRadius = UDim.new(0, 4)

            local ChinookLabel = Instance.new("TextLabel", ItemFrame)
            ChinookLabel.Size = UDim2.new(1, -10, 1, 0)
            ChinookLabel.Position = UDim2.new(0, 10, 0, 0)
            ChinookLabel.Text = "CHINOOK " .. tostring(count)
            ChinookLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            ChinookLabel.Font = Enum.Font.GothamBold
            ChinookLabel.TextSize = 10
            ChinookLabel.TextXAlignment = Enum.TextXAlignment.Left
            ChinookLabel.BackgroundTransparency = 1

            local ClickBtn = Instance.new("TextButton", ItemFrame)
            ClickBtn.Size = UDim2.new(1, 0, 1, 0)
            ClickBtn.BackgroundTransparency = 1
            ClickBtn.Text = ""

            local chinookModel = item
            ClickBtn.MouseButton1Click:Connect(function()
                local assento = chinookModel:FindFirstChild("PilotSeat", true) 
                    or chinookModel:FindFirstChildOfClass("VehicleSeat") 
                    or chinookModel:FindFirstChildOfClass("Seat")
                if assento then
                    executarBypassAssento(assento)
                end
            end)
        end
    end

    ChinookTitle.Text = "CHINOOKS (" .. tostring(count) .. ")"
    ChinookScrollFrame.CanvasSize = UDim2.new(0, 0, 0, count * 35)
end

