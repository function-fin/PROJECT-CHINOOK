local function UpdatePlayerList()
    for _, child in pairs(PlayerScrollFrame:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end

    local count = 0
    local players = Players:GetPlayers()

    for _, p in pairs(players) do
        if p ~= LocalPlayer then
            count = count + 1
            
            local ItemFrame = Instance.new("Frame", PlayerScrollFrame)
            ItemFrame.Size = UDim2.new(1, -6, 0, 30)
            ItemFrame.BackgroundColor3 = (TargetPlayer == p) and Color3.fromRGB(30, 30, 30) or Color3.fromRGB(18, 18, 18)
            
            local ItemCorner = Instance.new("UICorner", ItemFrame)
            ItemCorner.CornerRadius = UDim.new(0, 4)

            -- Foto de Perfil (Thumbnail)
            local AvatarImg = Instance.new("ImageLabel", ItemFrame)
            AvatarImg.Size = UDim2.new(0, 22, 0, 22)
            AvatarImg.Position = UDim2.new(0, 4, 0.5, -11)
            AvatarImg.BackgroundTransparency = 1
            
            task.spawn(function()
                local content, isReady = Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
                if isReady then AvatarImg.Image = content end
            end)

            local AvatarCorner = Instance.new("UICorner", AvatarImg)
            AvatarCorner.CornerRadius = UDim.new(0, 11)

            -- Nome do Player
            local DisplayName = Instance.new("TextLabel", ItemFrame)
            DisplayName.Size = UDim2.new(0, 180, 0, 12)
            DisplayName.Position = UDim2.new(0, 32, 0, 3)
            DisplayName.Text = p.DisplayName
            DisplayName.TextColor3 = Color3.fromRGB(255, 255, 255)
            DisplayName.Font = Enum.Font.GothamBold
            DisplayName.TextSize = 9
            DisplayName.TextXAlignment = Enum.TextXAlignment.Left
            DisplayName.BackgroundTransparency = 1
            DisplayName.TextStrokeTransparency = 1

            local Username = Instance.new("TextLabel", ItemFrame)
            Username.Size = UDim2.new(0, 180, 0, 10)
            Username.Position = UDim2.new(0, 32, 0, 15)
            Username.Text = "@" .. p.Name
            Username.TextColor3 = Color3.fromRGB(140, 140, 140)
            Username.Font = Enum.Font.Gotham
            Username.TextSize = 8
            Username.TextXAlignment = Enum.TextXAlignment.Left
            Username.BackgroundTransparency = 1
            Username.TextStrokeTransparency = 1

            if TargetPlayer == p then
                local CheckImg = Instance.new("TextLabel", ItemFrame)
                CheckImg.Size = UDim2.new(0, 16, 0, 16)
                CheckImg.Position = UDim2.new(1, -22, 0.5, -8)
                CheckImg.Text = "✓"
                CheckImg.TextColor3 = Color3.fromRGB(255, 255, 255)
                CheckImg.Font = Enum.Font.GothamBold
                CheckImg.TextSize = 10
                CheckImg.BackgroundTransparency = 1
                CheckImg.TextStrokeTransparency = 1
            end

            local ClickBtn = Instance.new("TextButton", ItemFrame)
            ClickBtn.Size = UDim2.new(1, 0, 1, 0)
            ClickBtn.BackgroundTransparency = 1
            ClickBtn.Text = ""

            ClickBtn.MouseButton1Click:Connect(function()
                TargetPlayer = p
                UpdatePlayerList()
            end)
        end
    end

    ListTitle.Text = "LISTA DE JOGADORES (" .. tostring(count) .. ")"
    PlayerScrollFrame.CanvasSize = UDim2.new(0, 0, 0, count * 33)
end

